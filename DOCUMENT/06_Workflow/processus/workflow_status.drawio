        <mxCell id="l_backlog" value="&lt;b style=&quot;color: #238636;&quot;&gt;Vert (Backlog)&lt;/b&gt; : L'idée est notée, mais non priorisée ou en attente d'informations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#24292f;" vertex="1" parent="1">
          <mxGeometry x="60" y="375" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l_ready" value="&lt;b style=&quot;color: #0969da;&quot;&gt;Bleu (Ready)&lt;/b&gt; : La tâche est qualifiée, chiffrée et prête à être développée lors du prochain sprint." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#24292f;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l_inprog" value="&lt;b style=&quot;color: #9a6700;&quot;&gt;Jaune (In progress)&lt;/b&gt; : Un développeur travaille activement dessus en ce moment." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#24292f;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l_inrev" value="&lt;b style=&quot;color: #8250df;&quot;&gt;Violet (In review)&lt;/b&gt; : Le code est terminé et soumis à une relecture (Pull Request) ou aux tests." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#24292f;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l_done" value="&lt;b style=&quot;color: #cf222e;&quot;&gt;Rouge (Done)&lt;/b&gt; : Validé, fusionné (mergé) et potentiellement déployé." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#24292f;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="480" height="20" as="geometry" />
