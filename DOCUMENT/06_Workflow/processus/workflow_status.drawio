        </mxCell>

        <!-- Nodes -->
        <mxCell id="n1" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Backlog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #57606a;&quot;&gt;Cet élément n'a pas encore commencé&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#f0f8f1;strokeColor=#238636;strokeWidth=2;fontColor=#24292f;shadow=1;" vertex="1" parent="1">
