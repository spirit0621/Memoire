        </mxCell>
        <mxCell id="n2" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Ready&lt;/b&gt; (Prêt)&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #57606a;&quot;&gt;Cette tâche est prête à être traitée&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#f0f6fd;strokeColor=#0969da;strokeWidth=2;fontColor=#24292f;shadow=1;" vertex="1" parent="1">
