        <mxCell id="n3" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;In progress&lt;/b&gt; (En cours)&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #57606a;&quot;&gt;Cette tâche est activement travaillée&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#fff9f0;strokeColor=#9a6700;strokeWidth=2;fontColor=#24292f;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;In review&lt;/b&gt; (En revue)&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #57606a;&quot;&gt;Cette tâche est en cours de révision&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#f6f0ff;strokeColor=#8250df;strokeWidth=2;fontColor=#24292f;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="240" height="70" as="geometry" />
