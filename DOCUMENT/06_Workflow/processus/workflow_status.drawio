        <mxCell id="n5" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Done&lt;/b&gt; (Terminé)&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #57606a;&quot;&gt;Cette tâche a été complétée&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#fff1e5;strokeColor=#cf222e;strokeWidth=2;fontColor=#24292f;shadow=1;" vertex="1" parent="1">
