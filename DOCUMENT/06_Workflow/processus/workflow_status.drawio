        <mxCell id="title" value="Workflow des Tâches (Kanban)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#24292f;" vertex="1" parent="1">
