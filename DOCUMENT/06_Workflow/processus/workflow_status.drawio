        </mxCell>
        <mxCell id="subtitle" value="Représentation du cycle de vie d'une tâche (issue/ticket) depuis sa création jusqu'à sa finalisation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#57606a;" vertex="1" parent="1">
