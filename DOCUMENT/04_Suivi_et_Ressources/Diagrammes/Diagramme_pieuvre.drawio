                </mxCell>
                <mxCell id="legend" value="&lt;h3 style=&quot;margin-top:0px;&quot;&gt;Légende du Diagramme des Interactions (Pieuvre)&lt;/h3&gt;&lt;br&gt;&lt;b&gt;FP1 :&lt;/b&gt; Permettre à l'Administrateur RH de gérer les employés et de générer leurs fiches de paie.&lt;br&gt;&lt;br&gt;&lt;b&gt;FC1 :&lt;/b&gt; S'adapter aux besoins d'ergonomie et de rapidité de l'Administrateur RH.&lt;br&gt;&lt;br&gt;&lt;b&gt;FC2 :&lt;/b&gt; Être facile d'utilisation et fournir un accès rapide aux fiches de paie pour l'Employé.&lt;br&gt;&lt;br&gt;&lt;b&gt;FC3 :&lt;/b&gt; Respecter strictement la réglementation en vigueur (RGPD, Code du travail).&lt;br&gt;&lt;br&gt;&lt;b&gt;FC4 :&lt;/b&gt; Être compatible et responsive via un navigateur web moderne.&lt;br&gt;&lt;br&gt;&lt;b&gt;FC5 :&lt;/b&gt; Garantir le stockage sécurisé, intègre et fiable des données." style="text;html=1;strokeColor=#000000;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacing=10;fontFamily=Helvetica;" parent="1" vertex="1">
