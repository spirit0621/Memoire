                <mxCell id="A_qui" value="&lt;b style='font-size: 14px;'&gt;À qui rend-il service ?&lt;/b&gt;&lt;hr&gt;&lt;ul style='text-align: left;'&gt;&lt;li&gt;&lt;b&gt;Services RH :&lt;/b&gt; Gestion fluide et quotidienne&lt;/li&gt;&lt;li&gt;&lt;b&gt;Comptables :&lt;/b&gt; Exports fiables et vérifications&lt;/li&gt;&lt;li&gt;&lt;b&gt;Salariés :&lt;/b&gt; Transparence et justesse de la paie&lt;/li&gt;&lt;/ul&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
