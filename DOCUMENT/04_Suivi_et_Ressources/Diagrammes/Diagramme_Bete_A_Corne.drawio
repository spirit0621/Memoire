                <mxCell id="Produit" value="&lt;b style='font-size: 16px;'&gt;Application GFPS&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Gestion de Fiches de Paie Simplifiée)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;perimeterSpacing=2;" parent="1" vertex="1">
