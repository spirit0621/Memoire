                <mxCell id="Sur_quoi" value="&lt;b style='font-size: 14px;'&gt;Sur quoi agit-il ?&lt;/b&gt;&lt;hr&gt;&lt;ul style='text-align: left;'&gt;&lt;li&gt;&lt;b&gt;Données contractuelles&lt;/b&gt; (Contrats, salaires de base)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Variables mensuelles&lt;/b&gt; (Absences, primes)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cadre légal&lt;/b&gt; (Cotisations sociales, impôts)&lt;/li&gt;&lt;/ul&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
